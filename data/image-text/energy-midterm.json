{"assets/energy-midterm/questions/2023-1-26.webp":{"asset":"assets/problem-webp90/657670ebbc18fe1cc4fb6e36b1a5b1fe.webp","sha256":"7f1968448f1783f3182fdd9483135ac64344820c7a032003a6389935368d5754","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"26 다음 중 건식 집진장치에 해당하지 않는 것은?","choices":["백 필터","사이클론","벤튜리 스크레버","멀티클론"]}},"assets/energy-midterm/questions/2025-3-15.webp":{"asset":"assets/problem-webp90/92fc8742aa746de1907e3ba789076f93.webp","sha256":"923bf17305c8da835f7a2931d4ff660729adc104149041b9e8728f4dd5d1b2dc","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"15 보일러 집진장치 중 매진을 액막이나 액방울에 충돌\n시키거나 접촉시켜 분리하는 것은?","choices":["여과식","세정식","전기식","관성 분리식"]}},"assets/energy-midterm/questions/2023-4-29.webp":{"asset":"assets/problem-webp90/c41681728b018a4745e7bf2f0bfc4b89.webp","sha256":"93468932b8f8cb0a4da9a39cc2e68c488d86a37da916ee89f968e68688603fdd","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"다음 집진장치 중 집진효율이 가장 좋은 것은?","choices":["중력식","사이클론식","세정식","전기식"]}},"assets/energy-midterm/questions/2021-1-1.webp":{"asset":"assets/problem-webp90/e44483b0e0ebad08dd9e946c27146c0b.webp","sha256":"a69858c31d299ebe8ccb0b957f5f07b3df3eaa1ee4ed66195d2554a4440fad5f","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"열역학 제1법칙을 설명한 것 중 옳은 것은?","choices":["에너지 보존의 법칙이다.","열의 온도가 높은 곳에서 낮은 곳으로 흐른다.","한계에 있어서 유한수의 조작으로 절대 0도에\n도 달할 수는 없다.","얻은 열을 완전히 일로 변환시킬 수 있는 장치\n는 없다."]}},"assets/energy-midterm/questions/2021-1-14.webp":{"asset":"assets/problem-webp90/4049fb7418c6de655d1fc8462242e367.webp","sha256":"5b05e77bca4e793d16ac555cd22dc51d53d136a8306b0420a4a8ffa0e3590e11","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"열역학 제1법칙은 다음 중 어떠한 것과 관련이 있는가?","choices":["시스템의 열역학적 반응속도","시스템의 에너지 보존","시스템의 반응방향","시스템의 온도효과"]}},"assets/energy-midterm/questions/2022-1-1.webp":{"asset":"assets/problem-webp90/5f90b6af6fd62d3907c3d7a4485b2760.webp","sha256":"2f827004856866c23a688636ae44378bf42242d507ee3761dc70f46a2d36e9e2","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"열과 일에 대한 설명으로 틀린 것은?","choices":["모두 경로함수이다.","모두 양수의 값을 갖는다.","모두 불완전 미분형을 갖는다.","모두 경계를 통해 일어난다."]}},"assets/energy-midterm/questions/2022-1-13.webp":{"asset":"assets/problem-webp90/414feadd75ddebbab90bb5dc05886cfb.webp","sha256":"76fcf289dc56dd27098ae9a08308aa7c22da56df74614811d4883a20c4fc9349","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"기체가 가역 단열 팽창할 때와 가역 등온팽창할 때 이들\n중에서 내부에너지의 감소는?","choices":["같다. (변화가 없다.)","알 수 없다.","등온팽창 때가 크다.","단열팽창 때가 크다."]}},"assets/energy-midterm/questions/2022-2-75.webp":{"asset":"assets/problem-webp90/c2efad371670c782aedec6e542625242.webp","sha256":"f95c84c646e1190c065da0b1b1d838af3e42f3b8b115515a959ce1e20f0ede0b","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"75 보일러 급수의 탈기법 가운데 화학적 방법을 설명한\n것 중 관계없는 것은?","choices":["히드라진을 보일러 급수에 첨가하면 탈산소가\n이루어진다.","아황산나트륨을 보일러 급수에 첨가하면\n탈산소가 행하여진다.","기체 분압의 감소 및 가열에 의한 용해도 감소.\n비등과 확산 등이 발생한다.","탄닌은 저압보일러용의 탈산소제로서 사용\n되고 있다."]}},"assets/energy-midterm/questions/2025-3-2.webp":{"asset":"assets/problem-webp90/6f5892f133480b082e6d4c4ede0e73f8.webp","sha256":"3ba6de9864b7afcac5e9b7a9b3630024e90a25fb1086ccbd2913f98e8dfcd85b","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"02 기체연료의 장점에 해당하지 않는 것은?","choices":["저장이나 운송이 쉽고 용이하다.","비열이 작아서 예열이 용이하고 열효율, 화염\n온도 조절이 비교적 용이하다.","연료의 공급량 조절이 쉽고 공기와의 혼합을\n임의로 조절할 수 있다.","연소 후 유해잔류 성분이 거의 없다."]}},"assets/energy-midterm/questions/2024-2-8.webp":{"asset":"assets/problem-webp90/5289799785213a867230e2d339aad0cf.webp","sha256":"d912b4ad8b503921a912d03a54c0c3de515c45a025aa4aa8724091b921f08e47","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"08 기체연료의 일반적인 특징에 대한 설명으로 가장 거리\n가 먼 것은?","choices":["저장하기 쉽다.","열효율이 높다.","점화 및 소화가 간단하다.","연소용 공기 예열에 의해 저발열량이라도 전\n열효율을 높일 수 있다"]}},"assets/energy-midterm/questions/2025-1-56.webp":{"asset":"assets/problem-webp90/467eda9139569addd0ef06b75d31291f.webp","sha256":"5082078ab9e300c0e717837e0522b7880a23a975549c43c37500f0cba841a022","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"56 보일러의 자동제어와 관련된 약호가 틀린 것은?","choices":["FWC : 급수제어","ACC : 자동연소제어","ABC : 보일러 자동제어","STC : 증기압력제어"]}},"assets/energy-midterm/questions/2023-4-10.webp":{"asset":"assets/problem-webp90/2691f7b7e1848c79ce4e21065d562a4d.webp","sha256":"6cf541a264b013945d8847e2ab7c7affca2ef9b7563543b7e7d22f35e6184340","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"10 보일러에서 보염장치를 설치하는 목적으로 가장 거리\n가 먼 것은?","choices":["연소 화염을 안정시킨다.","안정된 착화를 도모한다.","저공기비 연소를 가능하게 한다.","연소가스 체류 시간을 짧게 해 준다."]}},"assets/energy-midterm/questions/2025-2-28.webp":{"asset":"assets/problem-webp90/6929b01fec178076833f6149d589f674.webp","sha256":"bea2db9e6e0e8b8dc6646ef3e2a5b4cd1a0381ea0fb22b629b87cfc86b854c25","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"28 보일러에서 보염장치를 설치하는 목적이 아닌 것은?","choices":["연소 화염을 안정시킨다.","안정된 착화를 도모한다.","연소가스 체류 시간을 짧게 해 준다.","저공기비 연소를 가능하게 한다."]}},"assets/energy-midterm/questions/2024-1-50.webp":{"asset":"assets/problem-webp90/53421d04387054a6062273b5cfea88e6.webp","sha256":"3e247d8735fbb38d8c05c8e0d527d877c8baf291a18fa5298c6550421f52a029","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"50\n신축이음 중 온수 혹은 저압증기의 배관분기관 등에\n사용되는 것으로 2개 이상의 엘보를 사용하여 나사맞\n춤부의 작용에 의하여 신축을 흡수하는 것은?","choices":["벨로즈 이음","슬리브 이음","스위블 이음","신축곡관"]}},"assets/energy-midterm/questions/2021-1-42.webp":{"asset":"assets/problem-webp90/f0dce17342a24fd122b8b24b9f273708.webp","sha256":"1f58658ac846114169f0bcb973002270488aeb1e893f1a4023de27ff9f8b438b","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"슬리브형 신축 이음쇠의 특성 설명 중 틀린 것은?","choices":["압력 15[kgf/cm3이상의 고압 증기 배관에\n적합하다.","루프형에 비해 설치 장소를 적게 차지한다.","신축으로 인한 응력이 생기지 않는다.","장기간 사용하면 패킹이 마모되어 유체가 누설\n된다."]}},"assets/energy-midterm/questions/2022-4-39.webp":{"asset":"assets/problem-webp90/dbafd101455dddfc995805f72d546c86.webp","sha256":"a37e71ef776ba31e4cc2d599c5d82a2c3eaa782344705946307316648a8e91d1","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"열팽창에 의한 신축을 흡수하고, 방진, 방음도 가능한\n신축이음은?","choices":["스위블형 신축이음","슬리브형 신축이음","루프형 신축이음","플렉시블 이음"]}},"assets/energy-midterm/questions/2021-2-21.webp":{"asset":"assets/problem-webp90/5772d5148a4eef83b2286284bc344cbf.webp","sha256":"730f9904b1003c7a1ef95631d33a800199b8216bc07d0c3eae1f44d36532551a","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"인터록(Interlock) 제어 중 하나로 대형 보일러 등에\n서 송풍기가 작동되지 않으면 전자밸브가 열리지 않고\n점화를 저지하는 것은?","choices":["불착화 인터록","저수위 인터록","프리퍼지 인터록","저연소 인터록"]}},"assets/energy-midterm/questions/2021-1-28.webp":{"asset":"assets/problem-webp90/8dc6fd2c99c2a831ecd79f9951553f26.webp","sha256":"11572a7d65f400131a22b59520a83ee8645bfb3b53774c79c3c911192637fed4","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"자동화학식 CO2 분석계의 특징으로 잘못 설명된 것은?","choices":["선택성이 좋지 않다.","구조에 유리부분이 많아 파손되기 쉽다.","점검과 소모품의 보수에 시간이 걸린다.","조성가스가 여러 종류인 경우도 높은 정도(*낮)\n로 측정할 수 있다."]}},"assets/energy-midterm/questions/2022-2-47.webp":{"asset":"assets/problem-webp90/340c851756b9a5a302aba60230c5bff4.webp","sha256":"53fb2c9cbf37cc9ecf06a1c3ecce69f5f16b38d99299975a08dcd189fbb30b36","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"매연분출장치 중에서 롱 레트랙터(Iongretractable)\n형의 주요 사용 장소에 대해 올바르게 설명한 것은?","choices":["보일러의 고온부인 과열기나 고온의 열가스\n통로 부분에 사용한다.","보일러의 연소실 노벽 등에 부착하여 타고님\n은 찌꺼기를 제거한다.","보일러 전열면, 절탄기 등에 사용하며 자동\n식과 수동식이 있다.","관형의 공기예열기에 사용되며 원격조작이가\n능하다."]}},"assets/energy-midterm/questions/2022-1-6.webp":{"asset":"assets/problem-webp90/5f64b7c3b8437d05a85b44bd17d82e25.webp","sha256":"3e3b3471bcb315d125b6c8ca274d15679933246fbf266735c34fd1276d94d2d4","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"매연 방지조치로서 부적당한 것은?","choices":["보일러에 적합한 연료를 선택한다.","무리하게 불을 피우지 않도록 한다.","통풍을 많게 하여 충분한 공기를 주입한다.","연소실 내의 온도가 내려가지 않도록 공기를\n적정하게 보낸다."]}},"assets/energy-midterm/questions/2022-4-29.webp":{"asset":"assets/problem-webp90/c361fb3f8f32c850e5f2b3476f07bf2b.webp","sha256":"ca7ee66134db46ef15c2344a3760caef31ba5bd5d7d9240e15b23a1087fd7502","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"29 증기트랩을 사용하는 이유로 가장 적합한 것은?","choices":["증기배관 내의 수격작용을 방지한다.","증기의 송기량을 증가시킨다.","증기배관의 강도를 증가시킨다","증기발생을 왕성하게 해준다."]}},"assets/energy-midterm/questions/2023-2-22.webp":{"asset":"assets/problem-webp90/eceac4769bf6fc48fb5a6031dfc96688.webp","sha256":"047a7876ad735e14e37027e658f2902787d1e045924a7eb45cbb8fd161877fa5","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"22 증기트랩의 설치에 관한 설명으로 옳은 것은?","choices":["응축수와 증기를 배출하기 위하여 설치하는\n중요한 부품이다.","응축수량이 많이 발생하는 증기관에는 열동식\n트랩이 주로 사용된다.","냉각래그(cooling leg)는 1.5m 이상 설치하며\n증기 공급관의 관말부에 설치한다.","증기트랩의 주위에는 바이패스관을 설치할\n필요가 없다."]}},"assets/energy-midterm/questions/2025-1-23.webp":{"asset":"assets/problem-webp90/3207b28d3a3bbc69e5437749c6e89a77.webp","sha256":"b13ba3b5e9dc38c262eca3aaf28bc872062ffe66f52c9eded0518f8ad94f3b9b","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"23 증기트랩을 설치할 경우 나타나는 장점이 아닌 것은?","choices":["응축수로 인한 관 내의 부식을 방지할 수 있다.","응축수를 배출할 수 있어서 수격작용을 방지\n할 수 있다.","관 내 유체의 흐름에 대한 마찰 저항을 줄일\n수 있다.","관 내의 불순물을 제거할 수 있다."]}},"assets/energy-midterm/questions/2021-1-55.webp":{"asset":"assets/problem-webp90/3155e5b8d8f2476e34625b1c3be8a23b.webp","sha256":"80d9270a59a97abfb2ab448ff32225dab2e796e2867e820b018fdc89e431b3af","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"최고사용압력이 0.5[MPa]의 강제압력용기에 대해\n수압시험을 하고자 할 때 몇 [MPa]로 수압시험을 해\n야하는가? (단, 온도보정 전과 온도보정 후의 수압시험\n압력은 같다고 본다.)","choices":["0.25","0.5","0.75","1.0"]}},"assets/energy-midterm/questions/2022-2-74.webp":{"asset":"assets/problem-webp90/2b158bca5f77047658c5ab3af95d187d.webp","sha256":"37a061ebc2306c17d9f102a9f6de119fe3662b1f5bac6f56e1202312bed9817f","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"강철제 증기보일러의 수압시험 방법에 대한 설명으로\n틀린 것은?","choices":["공기를 빼고 물을 채운 후 천천히 압력을 가한다.","수압시험 중 또는 시험 후에도 물이 얼지 않\n도록 하여야 한다.","규정된 시험 수압에 도달한 수 10분이 경과한\n뒤 검사를 실시한다.","수압시험은 규정된 압력의 6%] 이상을 초과\n하지 않도록 적절한 제어를 마련한다."]}},"assets/energy-midterm/questions/2021-1-78.webp":{"asset":"assets/problem-webp90/debb476532bca15ba2404163f0297b7c.webp","sha256":"a99c2dc1f64ad7fec79805d0abbcbaecc26553891da4184c179b9fd398be8471","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"• 일반 원통 보일러에서 급수의 pH 기준으로 옳은것은?\n(단, 25°C 기준으로 최고사용압력은 1[MPa] 이하이며,\n보급수는 연화수를 사용한다.)","choices":["1~3","4~6","7~9","11~13"]}},"assets/energy-midterm/questions/2023-4-50.webp":{"asset":"assets/problem-webp90/abef978e2e069c4f2790aabb19de2cc7.webp","sha256":"f2120add3b6e364855f93629116c1cabe659a1e7c28c0a54e6ffb483a5a69fae","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 수의 내처리를 위한 약제인 청관제를 사용하는\n목적이 아닌 것은?","choices":["스케일 생성을 억제하기 위해 사용","보일러 수를 알칼리수로 유지하여 부식을 방지","수소이온농도(pH)를 조절","용존 고형물 및 유지분 제거"]}},"assets/energy-midterm/questions/2021-1-77.webp":{"asset":"assets/problem-webp90/bc764d31a2b2ddb23cba02b9c2620c59.webp","sha256":"f4663ed774e677e79feb2ebc2de8f1fc06e9cab487f494187661515e36bafec8","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"가성취화 현상의 특징 설명으로 틀린 것은?","choices":["고압보일러에서 보일러수의 알칼리 농도가\n높은 경우에 발생한다.","외견상 부식성이 없고, 극히 미세한 불규칙적\n인 방사상 형태를 하고 있다.","발생하는 장소로는 반드시 수면위의 리벳부나\n관구멍 등 응력이 분산하는 곳의 틈이 많은\n곳이다.","저압보일러에서도 열부하가 매우 클 때에는\n발생할 가능성이 있다."]}},"assets/energy-midterm/questions/2022-4-49.webp":{"asset":"assets/problem-webp90/7ced5d1fcd666ca1c957886f70412919.webp","sha256":"0120cb0a842a86ec2acc320d251eda7d87a8b00012544b313144e3441d60e023","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"49 보일러 점화 시 역화의 원인에 해당되지 않는 것은?","choices":["프리퍼지가 불충분 하였을 경우","착화가 지연되거나 혹은 불착화를 발견하지\n못하고 연료를 노내에 분무한 경우","점화원(점화봉, 점화용 전극)을 사용하였을\n경우","연료의 공급밸브를 필요이상 급개 하였을 경우"]}},"assets/energy-midterm/questions/2023-2-63.webp":{"asset":"assets/problem-webp90/902c7390f0f4f33c93bb71b89c22f3aa.webp","sha256":"d596c2d91f7b0ecbac84449b6cd72b60baac8e81894bc20ee9baf98a058e33ab","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"63 보일러 운전 중 역화방지 대책에 대한 설명으로 옳은\n것은?","choices":["점화 시 착화는 천천히 한다.","노 내에 연료를 우선 공급한 후 공기를 공급\n한다.","점화 시 댐퍼를 닫고 미연소가스를 배출시킨\n뒤 점화한다.","실화 시 재점화 할 때는 노 내는 충분히 환기\n시킨 후 점화한다."]}},"assets/energy-midterm/questions/2025-2-52.webp":{"asset":"assets/problem-webp90/52ce5b17dc6bd4209793f8885036b9fd.webp","sha256":"688e1b2b0cef4deceeba390c6680216b98a29b35bb811a084654b16a876df577","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러의 오일 연소장치에서 역화가 발생하는 원인\n으로 적절치 않은 것은?","choices":["1차 공기의 압력 부족","2차 공기의 과대한 예열","물또는 협잡물의 혼합","점화 시 프리퍼지 부족"]}}}
