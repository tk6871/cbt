estions/2022-2-63.webp":{"asset":"assets/problem-webp90/1b1219b578c0fc7f60b1c425ad9be6f3.webp","sha256":"b15f661ae155c3c1301e9a83d7faeb16a61a35828c2bf611ca4244e9a66bc773","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 수중의 용존산소에 의한 국부전지가 구성되어\n앵기는 선기 화학적 무식에 해딩 되든 것은?","choices":["알칼리 부식","가성취하","구식(grooving)","점식(pitting)"]}},"assets/energy-textbook/questions/2022-2-75.webp":{"asset":"assets/problem-webp90/7b031750e45c36c91f6cedbedb81a34f.webp","sha256":"06f467ad4777492d7092f51947f86a1c166e1f9a1b5637014a88cd624fde37cb","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 급수의 탈기법 가운데 화학적 방법을 설명한\n것 중 관계없는 것은?","choices":["히드라진을 보일러 급수에 첨가하면 탈산소가\n이루어진다.","아황산나트륨을 보일러 급수에 첨가하면\n탈산소가 행하여진다.","기체 분압의 감소 및 가열에 의한 용해도 감소.\n비등과 확산 등이 발생한다.","탄닌은 저압보일러용의 탈산소제로서 사용\n되고 있다."]}},"assets/energy-textbook/questions/2018-4-15.webp":{"asset":"assets/problem-webp90/9e101c0066a27e3fad8c743725593257.webp","sha256":"69804aa170cfd048f0e3d8840ab39a48586d0ab806744ab024756fd36e7d37b0","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"기체연료 연소장치 중 가스버너의 특징으로 틀린 것\n은?","choices":["공기비 제어가 불가능하다.","정확한 온도제어가 가능하다.","연소상태가 좋아 고부하 연소가 용이하다.","버너의 구조가 간단하고 보수가 용이하다"]}},"assets/energy-textbook/questions/2019-4-2.webp":{"asset":"assets/problem-webp90/f7e4ac7d70fae9cacfa614253d7ec9ac.webp","sha256":"af01c251dfa2d58ee923e7eb841c3028ac455de4f5ad8abf465af88fb203824d","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"액체연료의 특징에 대한 설명으로 틀린 것은?","choices":["수송과 저장이 편리하다.","단위 중량에 대한 발열량이 석탄보다 크다.","인화, 역화 등 화재의 위험성이 없다.","연소 시 매연이 적게 발생한다."]}},"assets/energy-textbook/questions/2021-2-15.webp":{"asset":"assets/problem-webp90/edbe28eac5a008ddcf9728930d6c7440.webp","sha256":"9fb5eb51f726b0c7dca82d621ddc5c761be43db9846a6014f466f425c0ca2aa8","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"기체연료의 관리에 대한 문제점을 설명한 내용 중 잘못\n된 것은?","choices":["저장이나 수송에 어려움이 있다.","누설 시 화재, 폭발의 위험이 크다.","연소효율이 낮고 연소제어가 어렵다","시설비가 많이 들고 설비공사에 기술을 요한다."]}},"assets/energy-textbook/questions/2023-1-2.webp":{"asset":"assets/problem-webp90/d58c35bfdfb6612c12f357d1b26a8c42.webp","sha256":"71a8471b56dcee440e28fa61983756536a7ea88a26a79a6aeb9ef6e20fde76ed","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"기체연료의 장점에 해당하지 않는 것은?","choices":["저장이나 운송이 쉽고 용이하다.","비열이 작아서 예열이 용이하고 열효율, 화염\n온도 조절이 비교적 용이하다.","연료의 공급량 조절이 쉽고 공기와의 혼합을\n임의로 조절할 수 있다.","연소 후 유해잔류 성분이 거의 없다."]}},"assets/energy-textbook/questions/2025-3-2.webp":{"asset":"assets/problem-webp90/c72c4c966b83c9957f220c933c0c24d0.webp","sha256":"d0f5618afe380ebe5b05ac50117dcceb6a480a5134121118fb7ac4f4fb315e25","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"기체연료의 장점에 해당하지 않는 것은?","choices":["저장이나 운송이 쉽고 용이하다.","비열이 작아서 예열이 용이하고 열효율, 화염\n온도 조절이 비교적 용이하다.","연료의 공급량 조절이 쉽고 공기와의 혼합을\n임의로 조절할 수 있다.","연소 후 유해잔류 성분이 거의 없다."]}},"assets/energy-textbook/questions/2020-3-25.webp":{"asset":"assets/problem-webp90/ba2bb9e206e659724a9de9b498686d93.webp","sha256":"d246d322131db6fbdf90ce282f156927c8fc00fbc8658ab751475afc326aacaa","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기보일러의 용량표시 방법 중 일반적으로 가장 많이\n사용되는 정격용량은 무엇을 의미하는가?","choices":["상당증발량","최고사용압력","상당방열면적","시간당 발열량"]}},"assets/energy-textbook/questions/2018-4-48.webp":{"asset":"assets/problem-webp90/5a0bddca50118b95796016756532ded6.webp","sha256":"8777983d0afbc59c88496d0738fa05736d5f76b303261f942488edc734cfe117","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러의 부대장치에 대한 설명으로 옳은 것은?","choices":["윈드박스는 흡입통풍의 경우에 풍도에서의\n정압을 동압으로 바꾸어 노 내에 유입시킨다.","보염기는 보일러 운전을 정지할 때 진화를 원활\n하게 한다.","플레임 아이는 연소 중에 발생하는 화염빛을\n감지부에서 전기적 신호로 바꾸어 화염의 유무\n를 검출한다.","플레임 로드는 연소온도에 의하여 화염의 유무\n를 검출한다."]}},"assets/energy-textbook/questions/2021-1-42.webp":{"asset":"assets/problem-webp90/f4afed2e91f24062fe7f57d29f803def.webp","sha256":"2a34b1586ae7996f2ef3cd86ab74f8d9d79bc92813139a987a54e69d8aab77f0","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"슬리브형 신축 이음쇠의 특성 설명 중 틀린 것은?","choices":["압력 15[kgf/cm?]이상의 고압 증기 배관에\n적합하다.","루프형에 비해 설치 장소를 적게 차지한다.","신축으로 인한 응력이 생기지 않는다.","장기간 사용하면 패킹이 마모되어 유체가 누설\n된다."]}},"assets/energy-textbook/questions/2022-4-39.webp":{"asset":"assets/problem-webp90/08820e0f27612a08114d7589e5d60a3c.webp","sha256":"fba263fc5cd780614fc3a6782d8ba0831edb60031ba9b2179c2c14f8f419394e","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"열팽창에 의한 신축을 흡수하고, 방진, 방음도 가능한\n신축이음은?","choices":["스위블형 신축이음","슬리브형 신축이음","루프형 신축이음","플렉시블 이음"]}},"assets/energy-textbook/questions/2019-1-39.webp":{"asset":"assets/problem-webp90/c8626bef37b51f35960213f99aef2152.webp","sha256":"ff1c9048a82299048ff707fddbed89e39c8c045de4ada356f8a69012fb875866","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 연소특성으로 어떤 조건이 충족되지 않으면\n다음 동작이 중지되는 인터록(InterLock)의 종류가\n아닌 것은?","choices":["온오프 인터록","불착화 인터록","저수위 인터록","프리퍼지 인터록"]}},"assets/energy-textbook/questions/2021-2-21.webp":{"asset":"assets/problem-webp90/60f97607b3ac9b0db344357e5e7dfea4.webp","sha256":"c449410173d222ebdd4d9b6eec2c2d15a944167d4296eb1525402419a4650bbf","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"인터록(Interlock) 제어 중 하나로 대형 보일러 등에\n서 송풍기가 작동되지 않으면 전자밸브가 열리지 않고\n점화를 저지하는 것은?","choices":["불착화 인터록","저수위 인터록","프리퍼지 인터록","저연소 인터록"]}},"assets/energy-textbook/questions/2018-2-64.webp":{"asset":"assets/problem-webp90/48367853fdef2b2f32eb217576f7e2f1.webp","sha256":"c7c658800a0dc3f97e3252ee2ea4542a6601f67c18bcc5e276ba6e9e78b7c3c9","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러에서 그을음 불어내기(슈트 블로워) 작업을 할\n때의 주의사항으로 틀린 것은?","choices":["댐퍼의 개도를 줄이고 통풍력을 적게 한다.","한 장소에 장시간 불어 대지 않도록 한다.","슈트 블로우를 하기 전에 충분히 드레인을 실시\n한다.","소화한 직후의 고온 연소실 내에서는 하여서\n는 안 된다."]}},"assets/energy-textbook/questions/2018-4-12.webp":{"asset":"assets/problem-webp90/d1f896eedc71338e426e76a8e3689639.webp","sha256":"c3f1364f47ed5cc3591eea766b1d93a92bf59da11d75b6c8874d4b6e8a24b670","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"매연의 발생 방지방법으로 틀린 것은?","choices":["공기비를 최소화하여 연소한다.","보일러에 적합한 연료를 선택한다.","연료가 연소하는데 충분한 시간을 준다.","연소실 내의 온도가 내려가지 않도록 공기를\n적정하게 보낸다."]}},"assets/energy-textbook/questions/2019-2-21.webp":{"asset":"assets/problem-webp90/007393d8c8b744c435b23015421163a4.webp","sha256":"8f9fbdce4faa5675b4cdb500b46c7d47777433deb1eda0b6904568d625c47e08","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"가스분석방법으로 세라믹 0,계에 대한 설명으로 옳은\n것은?","choices":["응답이 느리다.","온도조절용 전기로가 필요 없다.","연속측정이 가능하며 측정범위가 좁다.","측정가스 중에 가연성 가스가 존재하면 사용\n이 불가능하다."]}},"assets/energy-textbook/questions/2019-4-13.webp":{"asset":"assets/problem-webp90/bfe5bf00c07256c8582c0ab79cb2c800.webp","sha256":"0aa7d7d9b5f5211c86ee6b2b7b90a76cd63edc4ca51a269d8f2737e7cf95b3cd","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 매연의 발생 원인으로 틀린 것은?","choices":["연소 기술이 미숙할 경우","통풍이 많지나 부족할 경우","연소실의 온도가 너무 낮을 경우","연료와 공기가 충분히 혼합된 경우"]}},"assets/energy-textbook/questions/2020-3-55.webp":{"asset":"assets/problem-webp90/f31bbec41e8b0115d4a89e9e275edf91.webp","sha256":"1d89a3c57ab75df46e516a8f19cccc3b9837f29c37621ed43a1d04a76d650be0","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"주로 보일러 전열면이나 절탄기에 고정 설치해 두며,\n분사관은 다수의 작은 구멍이 뚫려 있고 이곳에서 분사\n되는 증기로 매연을 제거하는 것으로서 분사관은 구조상\n고온가스의 접촉을 고려해야 하는 매연 분출장치는?","choices":["롱레트랙터블형","쇼트레트랙터블형","정치 회전형","공기예열기 클리너"]}},"assets/energy-textbook/questions/2020-3-59.webp":{"asset":"assets/problem-webp90/2df15ef5e5c1b0021f46c971dda8f7a3.webp","sha256":"117276d8cfbd6a12badc3389cf942042034af330c80f967e617def21b4f41d7a","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"연도나 매연 속에 복사광선을 통과시켜 광도변화에 따른\n매연농도가 지시 기록된다. 이 농도계의 명칭은?","choices":["링겔만 매연농도계","광전관식 매연농도계","전기식 매연농도계","매연포집 중량계"]}},"assets/energy-textbook/questions/2021-2-24.webp":{"asset":"assets/problem-webp90/ba35ef650f870ec0c006cd2da36f990c.webp","sha256":"a4f0c9cd388bac8f7c5c611e34cbbbb47fdf1dc125d91b5ef859f12998a05351","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"가스 분석에서 시료가스 채취시의 주의사항으로 잘못\n된 것은?","choices":["고온 가스의 채취관은 석영관, 자기관을 사용\n한다.","저온 가스의 채취관은 동관, 황동관을 사용\n한다.","시료가스의 채취구 위치에 주의하여야 채취\n한다.","채취배관은 되도록 깊게 하고 기울어지지 않게\n수평으로 배관한다."]}},"assets/energy-textbook/explanations/2021-2-26.webp":{"asset":"assets/problem-webp90/e6a2bb9aaf29079561269eea265b510a.webp","sha256":"71bd0979fdaef1e3055e2dc678cda4d94bc9c8254f353884bbc4f857ee86b2fe","kind":"explanation","status":"provisional","eligible":true,"text":"해선\n가스 분석계의 분류 및 종류\n⑦ 화학적 가스분석계\n연소열, 용액흡수제. 고체흡수제을 이용\nL 물리적 가스분석계\n열전도율. 밀도 및 점도차, 광학적성질, 전기전도도. 자기적\n성질, 반응성. 적외선 흡수를 이용"},"assets/energy-textbook/questions/2022-1-6.webp":{"asset":"assets/problem-webp90/d05a04f3d5dab3077bbede76f91b3c0b.webp","sha256":"bc0d9330af22665e6d4f79edabed3046cb9189025ec8994e3ffcb689d7c91bb8","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"매연 방지조치로서 부적당한 것은?","choices":["보일러에 적합한 연료를 선택한다","무리하게 불을 피우지 않도록 한다.","통풍을 많게 하여 충분한 공기를 주입한다.","연소실 내의 온도가 내려가지 않도록 공기를\n적정하게 보낸다."]}},"assets/energy-textbook/explanations/2022-2-6.webp":{"asset":"assets/problem-webp90/4e115b688371111616c197656d47bdbf.webp","sha256":"6b11b27dd622a7328319696871e9b4fbc82eb8b6555e285fce43cfff9575a86a","kind":"explanation","status":"provisional","eligible":true,"text":"해선\n타르의 특성\n석탄, 석유 등에서 나오는 점성이 있는 검은색의 액체로 서로\n다른 여러 가지 물질로 이루어져 타 연료에 비해서 연소 시\n에 매연 발생 가능성이 높다"},"assets/energy-textbook/questions/2022-2-39.webp":{"asset":"assets/problem-webp90/021478b5c74eebbcebc721c18dc790b8.webp","sha256":"0a463af9fb87ed892604341943e6d53ae3102619cf1d8412d1f2c9538856410a","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"다음은 가스분석계인 자동화학식 CO2계에 대한 설명\n이다. 틀린 것은?","choices":["오르자트(Orsat)식 가스분석계와 같이 CO2\n를 흡수액에 흡수시켜서 이것에 의한 시료 가스\n용액의 감소를 측정하고 CO2 농도를 지시한다.","피스톤의 운동으로 일정한 용적의 시료 가스\n가 KOH 용액 중에 분출되며 C02는 여기서\n용액에 흡수되지 않는다.","조작은 모두 자동화되어 있다.","흡수액에 따라서는 02 및 CO의 분석계로도\n사용할 수 있다."]}},"assets/energy-textbook/questions/2022-2-47.webp":{"asset":"assets/problem-webp90/0d3e28dc63cdb94dee13d67280ca4b5a.webp","sha256":"2741a2b0a7341cd6abf5e0f4a6b301091a9a98f0828f52b8008b8ea3099e1c75","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"매연분출장치 중에서 롱 레트랙터(longretractable)\n형의 주요 사용 장소에 대해 올바르게 설명한 것은?","choices":["보일러의 고온부인 과열기나 고온의 열가스\n통로 부분에 사용한다.","보일러의 연소실 노벽 등에 부착하여 타고남\n은 찌꺼기를 제거한다.","보일러 전열면, 절탄기 등에 사용하며 자동\n식과 수동식이 있다.","관형의 공기예열기에 사용되며 원격조작이가\n능하다."]}},"assets/energy-textbook/questions/2022-4-45.webp":{"asset":"assets/problem-webp90/6400411985648ee79979b315a7a16159.webp","sha256":"660971d61ac09e51af725f5395199357e418a0a9eefbdb8b65b06846b698188f","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"가스 분석을 위한 시료채취 방법으로 틀린 것은?","choices":["시료채취 시 공기의 침입이 없도록 한다.","가능한 한 시료 가스의 배관을 짧게 한다.","시료 가스는 가능한 한 벽에 가까운 가스를\n채취한다.","가스성분과 화학성분을 일으키는 배관쟤나\n부품을 사용하지 않는다."]}},"assets/energy-textbook/questions/2023-4-28.webp":{"asset":"assets/problem-webp90/9647668b3690c91065c1acacf86e19a2.webp","sha256":"52b76507e7f68a7cfc8bb50ca8e671fcfd3a34173e38632fbd5d8ff19836f106","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"다음 중 흡수제에 각 성분을 흡수시켜 흡수 전후의 체적\n변화로 측정하는 가스분석기는?","choices":["오르자트 분석기","적외선 분석기","가스크로마토그래피","도전율식 분석기"]}},"assets/energy-textbook/questions/2018-2-65.webp":{"asset":"assets/problem-webp90/4f6237149d09a7db16185c11d1875f6a.webp","sha256":"59a2f54aa0a16442f3f8be1262d0c0160c1734cf24c400065203f186905cb96f","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기트랩의 설치에 관한 설명으로 옳은 것은?","choices":["응축수와 증기를 배출하기 위하여 설치하는\n중요한 부품이다.","응축수량이 많이 발생하는 증기관에는 열동\n식 트랩이 주로 사용된다.","냉각래그(cooling leg)는 1.5m 이상 설치하\n며 증기 공급관의 관말부에 설치한다.","증기트랩의 주위에는 바이패스관을 설치할\n필요가 없다."]}},"assets/energy-textbook/questions/2019-1-62.webp":{"asset":"assets/problem-webp90/782762fd7aa97349bce4a89c5a975fff.webp","sha256":"56169fd5b16df0909055a6b1ae479247c6c49a20c1fa3ccdee911434345fb941","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기트랩을 사용하는 이유로 가장 적합한 것은?","choices":["증기배관 내의 수격작용을 방지한다.","증기의 송기량을 증가시킨다.","증기배관의 강도를 증가시킨다","증기발생을 왕성하게 해준다."]}},"assets/energy-textbook/questions/2020-1·2통합-49.webp":{"asset":"assets/problem-webp90/866faab1c46fadd8b66b82536339c87c.webp","sha256":"de03feb6e6c16ddc1bc184c14e3343d927cdc32b1b3b0e3f7a5970837d09cbba","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기트랩 중 고압증기의 관말트랩이나 유닛, 히터\n등에 많이 사용하는 것으로 상향식과 하향식이 있는\n트랩은?","choices":["벨로즈 트랩","플로트 트랩","온도조절식 트랩","버킷 트랩"]}},"assets/energy-textbook/questions/2022-4-29.webp":{"asset":"assets/problem-webp90/459398fda841c7b9cfe04631fe7f9fa5.webp","sha256":"2e61b58e7f366d54cd615e697bc9d73686b34f86ee60567403e9f3f47be00cb2","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기트랩을 사용하는 이유로 가장 적합한 것은?","choices":["증기배관 내의 수격작용을 방지한다.","증기의 송기량을 증가시킨다.","증기배관의 강도를 증가시킨다","증기발생을 왕성하게 해준다."]}},"assets/energy-textbook/questions/2023-2-22.webp":{"asset":"assets/problem-webp90/e6d117329606f2e477b9d4c149887d10.webp","sha256":"16d16c34c8f779e5ab1deb06aa2316dfc83e7b0998e7aad0cd6da5cf5bd34133","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기트랩의 설치에 관한 설명으로 옳은 것은?","choices":["응축수와 증기를 배출하기 위하여 설치하는\n중요한 부품이다.","응축수량이 많이 발생하는 증기관에는 열동식\n트랩이 주로 사용된다.","냉각래그(cooling leg)는 1.5m 이상 설치하며\n증기 공급관의 관말부에 설치한다.","증기트랩의 주위에는 바이패스관을 설치할\n필요가 없다."]}},"assets/energy-textbook/explanations/2023-2-22.webp":{"asset":"assets/problem-webp90/2bb72459285af515e897717e117c559f.webp","sha256":"b9dd78259ea36bef6cd32d83284643c8669aeab27b2da2bb4a3c87442c48ecb4","kind":"explanation","status":"provisional","eligible":true,"text":"얘 섷\n증기트랩의 설치\n⑦ 증기 중의 응축수를 배출하기 위하여 설치한다.\nL 응축수량이 많이 발생하는 증기관에는 기계식 트램을 사용\n한다.\nc 증기트랩 주위에는 고장에 대비하여 바이패스관올 설쳐\n해야 한다.\n② 냉각레그(cooling leg)\n방열기에서 열교환 후 발생된 옹축수를 배출하기 위하여\n설치되는 것으로 증기 공급관의 마지막 부분에서 분거된\n이후부터 트랩에 이르는 배관에는 여분의 증기가 충분히\n냉각되어 응축수가 될 수 있도록 보온을 하지 않은 냉각\n레그를 15[m]이상 설치해야 한다."},"assets/energy-textbook/questions/2025-2-36.webp":{"asset":"assets/problem-webp90/c25d1fdc02ad210d8d864bec707d93ee.webp","sha256":"19a629cc500467011f78ccc172d025e121ea336457c1bbe374157fb94b939fb6","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증기트랩의 설치에 관한 설명으로 옳은 것은?","choices":["응축수와 증기를 배출하기 위하여 설치하는\n중요한 부품이다.","응축수량이 많이 발생하는 증기관에는 열동\n식 트랩이 주로 사용된다","냉각레그(cooling leg)는 1.5m 이상 설치하\n며 증기 공급관의 관말부에 설치한다.","증기트랩의 주위에는 바이패스관을 설치할\n필요가 없다."]}},"assets/energy-textbook/questions/2018-2-67.webp":{"asset":"assets/problem-webp90/e5dc9c47410729bdb88f07dc72f46e2c.webp","sha256":"2467bbccc20d53efdd3cbd9e5e142a762e1a97d8412e7f7a0ec883c67ca301c2","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"강철제 보일러의 수압시험 방법에 관한 설명으로 틀린\n것은?","choices":["수압시험 중 또는 시험 후에도 물이 얼지 않도록\n해야 한다.","물을 채운 후 천천히 압력을 가한다.","규정된 시험수압에 도달된 후 30분이 경과된\n뒤에 검사를 실시한다.","시험수압은 규정된 압력의 10% 이상을 초과\n하지 않도록 적절한 제어를 마련한다."]}},"assets/energy-textbook/questions/2020-1·2통합-50.webp":{"asset":"assets/problem-webp90/afa09ecbfa815fd73b0027b0e99444a0.webp","sha256":"89dab9a9dcd36d293c70592b6dcca7b87b0ef0481518e30df2afdcea95105ca2","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"에너지이용 합리화법에 따라 개조검사 시 수압시험을\n실시해야 하는 경우는?","choices":["연료를 변경하는 경우","버너를 개조하는 경우","절탄기를 개조하는 경우","내압부분을 개조하는 경우"]}},"assets/energy-textbook/questions/2022-2-74.webp":{"asset":"assets/problem-webp90/5322cc74f083f1f158ffd82be0096d5b.webp","sha256":"5fc9b6a412f4bef0a35adf5d2845f732e386f580b634e89cbed2d1ec1c3ec31f","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"강철제 증기보일러의 수압시험 방법에 대한 설명으로\n틀린 것은?","choices":["공기를 빼고 물을 채운 후 천천히 압력을 가한다.","수압시험 중 또는 시험 후에도 물이 얼지 않\n도록 하여야 한다.","규정된 시험 수압에 도달한 수 10분이 경과한\n뒤 검사를 실시한다.","수압시험은 규정된 압력의 6[%] 이상을 초과\n하지 않도록 적절한 제어를 마련한다."]}},"assets/energy-textbook/questions/2021-1-78.webp":{"asset":"assets/problem-webp90/a4ea3d54263d541a566b98f5cf81661c.webp","sha256":"2645aa36979a7cdef671ed2c4b35357ed9729038e79d6d1d496553e660462369","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"일반 원통 보일러에서 급수의 pH 기준으로 옳은것은?\n(단, 25°C 기준으로 최고사용압력은 1MPa] 이하이며,\n보급수는 연화수를 사용한다.)","choices":["1~3","4~6","7~9","11~13"]}},"assets/energy-textbook/questions/2023-4-50.webp":{"asset":"assets/problem-webp90/8a9c24165b0952356317f4717626c7bb.webp","sha256":"ea47fc74e257851bb24ec560675902a1fe9d74d6a5a43be71d0c11b0b92f4ae6","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 수의 내처리를 위한 약제인 청관제를 사용하는\n목적이 아닌 것은?","choices":["스케일 생성을 억제하기 위해 사용","보일러 수를 알칼리수로 유지하여 부식을 방지","수소이온농도(pH)를 조절","용존 고형물 및 유지분 제거"]}},"assets/energy-textbook/questions/2018-2-71.webp":{"asset":"assets/problem-webp90/e4bdcdcdcd7e536a310833ba5c488baa.webp","sha256":"6bbd6d1a39487dc8a31d1a5e5dd807e33ac5cbae6851383e8a03a9d9b68bd813","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 내부부식 중의 하나인 가성취화의 특징에 관한\n설명으로 틀린 것은?","choices":["균열의 방향이 불규칙적이다.","주로 인장응력을 받는 이음부에 발생한다.","반드시 수면 위쪽에서 발생한다.","농알칼리 용액의 작용에 의하여 발생한다."]}},"assets/energy-textbook/questions/2021-1-77.webp":{"asset":"assets/problem-webp90/040b6d76059c14f64fb045716200b026.webp","sha256":"2556aaba0cf1f1c67bf308330f0ae892f5a8241a5e5d2b3329f548f8fdc7fa00","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"가성취화 현상의 특징 설명으로 틀린 것은?","choices":["고압보일러에서 보일러수의 알칼리 농도가\n높은 경우에 발생한다.","외견상 부식성이 없고, 극히 미세한 불규칙적\n인 방사상 형태를 하고 있다","발생하는 장소로는 반드시 수면위의 리벳부나\n관구멍 등 응력이 분산하는 곳의 틈이 많은\n곳이다.","저압보일러에서도 열부하가 매우 클 때에는\n발생할 가능성이 있다."]}},"assets/energy-textbook/questions/2021-2-64.webp":{"asset":"assets/problem-webp90/8f44c89dac6e9aca2c1ccd2e6e869075.webp","sha256":"5f94c3b2ec2589df0246e77607e93cee45e92fcbc6023c4f85f32e7492853259","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"증발관이나 본체 드럼 등 탄소강제 기기의 비등 전열\n이 심한 곳에 수처리 약품 등으로 인해 생기는 수산화\n나트륨 성분이 농축되어 발생하는 부식을 무엇이라고\n하는가?","choices":["황산노점 부식","알칼리 부식","입계 부식","갈바닉 부식"]}},"assets/energy-textbook/explanations/2021-2-64.webp":{"asset":"assets/problem-webp90/287a4f8892b30a81196933c95f47e794.webp","sha256":"dcdb84382556fad7bd5eaf3078349821a4c1f270e4d6868189375b2e7e6c0748","kind":"explanation","status":"provisional","eligible":true,"text":"알칼리 부식\n수산화나트륨(NaOH) 성분이 농축되어 발생하는 경우로\n증발관, 본체드럼 등 국부적 과열이나 보일러 수가 정체하는\n곳에서 발생한다."},"assets/energy-textbook/questions/2018-2-74.webp":{"asset":"assets/problem-webp90/914fb81721a7e0849ccbaa5e187f8e74.webp","sha256":"7aa66ef79e266cc730c0c9a791e1ba0aacba0f0c88cb55cac66c8b593ae3e9cc","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 점화 시 역화의 원인에 해당되지 않는 것은?","choices":["프리퍼지가 불충분 하였을 경우","착화가 지연되거나 혹은 불착화를 발견하지\n못하고 연료를 노내에 분무한 경우","점화원(점화봉, 점화용 전극)을 사용하였을\n경우","연료의 공급밸브를 필요이상 급개 하였을 경우"]}},"assets/energy-textbook/questions/2021-1-51.webp":{"asset":"assets/problem-webp90/252399296e0af77ddc61ecd7d4f9b76b.webp","sha256":"5865e8da36fad1c371f06b1ecb12f3f3b2962cb39e2957ce2f068583cfced162","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"산업용 중소형 보일러에 널리 이용되고 있는 강제혼합\n식 버너의 한 형식으로 역화의 위험이 있으나 고부하\n연소에 적합하고 화염의 크기도 작아지는 장점이 있는\n형식은?","choices":["적화식","분젠식","내부 혼합식","외부 혼합식"]}},"assets/energy-textbook/questions/2022-4-49.webp":{"asset":"assets/problem-webp90/fd3ec42465d8c60b8a4b47f2b8bcc390.webp","sha256":"2e8516bd1d70d0e6e614936d03e7af022382f1ea67387e1b96b01e19a3355596","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 점화 시 역화의 원인에 해당되지 않는 것은?","choices":["프리퍼지가 불충분 하였을 경우","착화가 지연되거나 혹은 불착화를 발견하지\n못하고 연료를 노내에 분무한 경우","점화원(점화봉, 점화용 전극)을 사용하였을\n경우","연료의 공급밸브를 필요이상 급개 하였을 경우"]}},"assets/energy-textbook/questions/2023-2-63.webp":{"asset":"assets/problem-webp90/da9a82e10e675db455a63006447de6f3.webp","sha256":"e2280164d8cb6b69addaa528f1aac616b68e9e45d433bd46aeefb2556f28b3b4","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 운전 중 역화방지 대책에 대한 설명으로 옳은\n것은?","choices":["점화 시 착화는 천천히 한다.","노 내에 연료를 우선 공급한 후 공기를 공급\n한다.","점화 시 댐퍼를 닫고 미연소가스를 배출시킨\n뒤 점화한다.","실화 시 재점화 할 때는 노 내는 충분히 환기\n시킨 후 점화한다."]}},"assets/energy-textbook/questions/2023-4-57.webp":{"asset":"assets/problem-webp90/1d9b5bf3a302c59f3be425b2d7fee999.webp","sha256":"8bc96885429f52c9595b64749ce6ecc6c76f231696aed1a4032f177f2d85a21d","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 점화 시 역화의 원인에 해당되지 않는 것은?","choices":["프리퍼지가 불충분 하였을 경우","착화가 지연되거나 혹은 불착화를 발견하지\n못하고 연료를 노내에 분무한 경우","점화원(점화봉, 점화용 전극)을 사용하였을\n경우","연료의 공급밸브를 필요이상 급개 하였을 경우"]}},"assets/energy-textbook/questions/2024-1-54.webp":{"asset":"assets/problem-webp90/a7f763fda99842a1adb7e868469fddd7.webp","sha256":"294dc61cc812e50fab4b03a14375ed6b28f31ce023a628f88b070da304ec2506","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러 점화 시 역화(3/k)의 원언으로 가장 거리가 먼\n것은?","choices":["프리퍼지가 부족했다.","연료 중에 물 또는 협잡물이 섞여 있었다.","연료 댐퍼가 열려 있었다.","유압이 과대했다."]}},"assets/energy-textbook/questions/2025-2-52.webp":{"asset":"assets/problem-webp90/9637ebcad242fb51a3430925ca109915.webp","sha256":"78192d070505028ff2ca8333b3fe04c3d90d037ea6421329f24dd457e195fdb0","kind":"question","status":"provisional","eligible":true,"text":"","question":{"stem":"보일러의 오일 연소장치에서 역화가 발생하는 원인\n으로 적절치 않은 것은?","choices":["1차 공기의 압력 부족","2차 공기의 과대한 예열","물 또는 협잡물의 혼합","점화 시 프리퍼지 부족"]}}}
