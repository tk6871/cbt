{
  "name": "industrial-cbt-modern-tools",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "audit:questions": "node tools/audit-question-data.mjs",
    "audit:explanations": "node tools/audit-explanation-quality.mjs",
    "audit:hvac-learning": "node tools/audit-hvac-learning-content.mjs",
    "audit:hansol": "node tools/audit-hansol-hvac.mjs",
    "audit:hvac-practical": "node tools/audit-hvac-practical.mjs",
    "audit:hvac-practical-images": "node tools/audit-hvac-practical-image-crops.mjs",
    "import:hvac-practical-restored": "node tools/import-hvac-practical-restored.mjs",
    "audit:answer-segments": "node tools/audit-hvac-answer-segments.mjs",
    "audit:answer-pixels": "node tools/audit-hvac-answer-pixels.mjs",
    "link:hvac-explanations": "node tools/link-hvac-additional-explanations.mjs",
    "build": "vite build && node tools/sync-pwa-service-worker.mjs",
    "analyze": "vite build",
    "build:android:web": "npm run build && node tools/build-android-web.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:key": "node tools/create-android-release-key.mjs",
    "android:debug": "npm run android:sync && node tools/build-android-debug.mjs",
    "android:release": "npm run android:sync && node tools/build-android-release.mjs",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install:release": "adb install -r dist/industrial-cbt-v4.9.2.apk",
    "dev": "vite --host 127.0.0.1",
    "test:a11y": "playwright test tools/ui-accessibility.spec.ts",
    "test:gem-target-exam": "node tools/test-gem-target-exam.mjs",
    "test:hotspot-editor": "node tools/test-hvac-hotspot-editor.mjs",
    "test:pwa": "node tools/test-pwa-build.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@cortex-js/compute-engine": "^0.120.0",
    "@lucide/vue": "^1.39.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/vue-virtual": "^3.13.36",
    "@vueuse/core": "^14.4.0",
    "canvas-confetti": "^1.9.4",
    "colorjs.io": "^0.7.1",
    "cropperjs": "^2.2.0",
    "dexie": "^4.2.0",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
    "katex": "^0.18.4",
    "motion": "^12.23.24",
    "open-props": "^1.7.23",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3",
    "reka-ui": "^2.10.4",
    "splitpanes": "^4.1.2",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.22",
    "vue-echarts": "^8.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "^3.1.1",
    "workbox-window": "7.4.1"
  }
}
