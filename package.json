{
  "name": "industrial-cbt-modern-tools",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "audit:questions": "node tools/audit-question-data.mjs",
    "review:intake": "python3 tools/review-intake.py",
    "audit:explanations": "node tools/audit-explanation-quality.mjs",
    "audit:hvac-learning": "node tools/audit-hvac-learning-content.mjs",
    "audit:hansol": "node tools/audit-hansol-hvac.mjs",
    "audit:hvac-practical": "node tools/audit-hvac-practical.mjs",
    "audit:hvac-practical-images": "node tools/audit-hvac-practical-image-crops.mjs",
    "import:hvac-practical-restored": "node tools/import-hvac-practical-restored.mjs",
    "audit:answer-segments": "node tools/audit-hvac-answer-segments.mjs",
    "audit:answer-pixels": "node tools/audit-hvac-answer-pixels.mjs",
    "link:hvac-explanations": "node tools/link-hvac-additional-explanations.mjs",
    "build": "node tools/build-admin-bank-index.mjs && node tools/build-problem-image-index.mjs --check && node tools/search-visibility-policy.mjs --write && vite build && node tools/build-static-textbook-sources.mjs && node tools/sync-pwa-service-worker.mjs",
    "analyze": "vite build",
    "build:android:web": "npm run build && node tools/build-android-web.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:key": "node tools/create-android-release-key.mjs",
    "android:preview": "npm run build && node tools/build-android-preview.mjs",
    "android:debug": "npm run android:sync && node tools/build-android-debug.mjs",
    "android:release": "npm run android:sync && node tools/build-android-release.mjs",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install:release": "node tools/install-android-release.mjs",
    "test:learning-safety": "vite build --config tools/sync-harness.vite.config.mjs && playwright test tools/learning-safety.spec.ts",
    "dev": "vite --host 127.0.0.1",
    "test:a11y": "playwright test tools/ui-accessibility.spec.ts",
    "test:gem-target-exam": "node tools/test-gem-target-exam.mjs",
    "test:hotspot-editor": "node tools/test-hvac-hotspot-editor.mjs",
    "test:pwa": "node tools/test-pwa-build.mjs",
    "test:search-policy": "node tools/test-search-visibility.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@cortex-js/compute-engine": "^0.120.0",
    "@preact/signals-core": "^1.14.5",
    "@preact/signals-react": "^3.12.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@use-gesture/react": "10.3.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "cropperjs": "^2.2.0",
    "deepsignal": "^1.6.0",
    "dexie": "^4.2.0",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.75.0",
    "motion": "^12.23.24",
    "open-props": "^1.7.23",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "react-router": "^7.18.5",
    "three": "^0.187.0",
    "ts-fsrs": "^5.4.2",
    "valtio": "^2.3.2",
    "wheel-gestures": "2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
