{
  "name": "industrial-cbt-modern-tools",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "audit:questions": "node tools/audit-question-data.mjs",
    "audit:answer-segments": "node tools/audit-hvac-answer-segments.mjs",
    "audit:answer-pixels": "node tools/audit-hvac-answer-pixels.mjs",
    "build": "vite build",
    "build:android:web": "npm run build && node tools/build-android-web.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:key": "node tools/create-android-release-key.mjs",
    "android:debug": "npm run android:sync && node tools/build-android-debug.mjs",
    "android:release": "npm run android:sync && node tools/build-android-release.mjs",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install:release": "adb install -r dist/industrial-cbt-v3.0.apk",
    "dev": "vite --host 127.0.0.1",
    "test:gem-target-exam": "node tools/test-gem-target-exam.mjs",
    "test:hotspot-editor": "node tools/test-hvac-hotspot-editor.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.57.4",
    "dexie": "^4.2.0",
    "motion": "^12.23.24",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
